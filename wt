#!/usr/bin/env bash
# Short wrapper for the worktree workflow. Usage:
#   ./wt list              show all bootstrapped worktrees (branch, ports, URL)
#   ./wt boot <spec>       bootstrap .worktrees/<spec> (once per worktree)
#   ./wt dev <spec>        run the dev server of .worktrees/<spec>
#   ./wt open <spec>       open its frontend URL in the browser
#   ./wt path <spec>       print its path (cd "$(./wt path <spec>)")
set -e
cmd="$1"; shift || true

# Allow bare spec names instead of full .worktrees/<spec> paths.
if [ $# -gt 0 ] && [[ "$1" != */* ]] && [ -d ".worktrees/$1" ]; then
  set -- ".worktrees/$1"
fi

case "$cmd" in
  boot) python scripts/bootstrap_worktree.py "$@" ;;
  list|dev|open|path) python scripts/wt.py "$cmd" "$@" ;;
  *) echo "usage: ./wt list|boot|dev|open|path [name]" >&2; exit 1 ;;
esac
